.venv/
__pycache__/
*.pyc
.pytest_cache/
web/data/*.geojson
web/data/*.json
web/data/*.html
web/data/private/
!web/data/.gitkeep
# One page per Bundesland, rewritten by every full pipeline run. The
# directory itself is tracked: under Docker it is the mountpoint for the
# generated pages, and /srv is read-only, so Docker cannot create it.
web/wickeltische/*
!web/wickeltische/.gitkeep
# Same story: /srv is a read-only bind mount of web/, so every directory
# mounted *inside* it must already exist in the repo — Docker cannot create
# the mountpoint and the container refuses to start (22 Aug 2026, two
# minutes of 502). web/private is the mountpoint for web-data/private.
web/private/*
!web/private/.gitkeep
/web-data/
*.sqlite
pipeline.log
.DS_Store
docs/DEPLOY.local.md
.playwright-mcp/
ops-state.json
ops.log
ops.env
# The private ops page's auth snippet (password hash) — server-only.
deploy/private/*.caddy
