                "en": "A changing table is in a general-purpose room (e.g. the hallway to the toilets)",
                "de": "Ein Wickeltisch ist in einem Mehrzweckraum (z. B. im Flur zu den Toiletten)"
              }
            },
            {
              "if": "changing_table:location=sales_area",
