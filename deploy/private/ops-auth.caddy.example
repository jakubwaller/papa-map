# Copy to deploy/private/ops-auth.caddy (git-ignored) on the server with a
# real token, then `docker compose restart papamap`. Imported into
# `route /private/*` in papamap.Caddyfile, in this order: the request either
# carries ?token=… (bookmark it — the cookie is set right there, so the plain
# URL works afterwards in that browser) or the cookie; anything else falls
# through to the route's 404. Token: `openssl rand -base64 30 | tr -d '/+='`.
# No referrer leaves the page, so the token in the URL stays in the browser.
@token query token=REPLACE-WITH-THE-TOKEN
@cookie header_regexp Cookie "(^|; *)papamap_ops=REPLACE-WITH-THE-TOKEN(;|$)"
header Referrer-Policy no-referrer
header @token Set-Cookie "papamap_ops=REPLACE-WITH-THE-TOKEN; Path=/private/; Secure; HttpOnly; SameSite=Lax; Max-Age=31536000"
file_server @token
file_server @cookie
