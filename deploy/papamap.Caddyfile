# Caddy config *inside* the papamap container. The public hostname, TLS and
# the reverse_proxy to here all live in the host Caddy (see papamap.caddy).
:8012 {
	encode gzip
	root * /srv
	file_server

	# The ops page is written by `pipeline.ops` next to stats.json (it lands
	# in the same mounted directory, /srv/data), but /ops.html is the address
	# worth remembering. Rewrite, not redirect: a bookmark keeps the short URL.
	rewrite /ops.html /data/ops.html

	# /?lang=en is the same static app — the language switch runs in JS — so
	# link unfurlers, which never run JS, carded the English URL with the
	# apex's German og:* head (Mastodon/Discord, 2026-08-27). Serve the
	# English-headed copy instead: web/index-en.html, generated from
	# index.html by web/build-index-en.js and pinned by index-en.test.js.
	# Rewrite, not redirect: the address being shared must stay /?lang=en.
	# Matched to the apex path only — /wickeltische/* pages already carry
	# their own language and must not be touched.
	@apex_en {
		path /
		query lang=en
	}
	rewrite @apex_en /index-en.html

	# The private ops page (the public one plus Cloudflare visit totals) lives
	# under /srv/private, a separate mount of web-data/private. Nothing under
	# /private/ is served unless deploy/private/*.caddy exists (git-ignored,
	# server-only) and brings its own basic_auth + file_server — a checkout
	# without it answers 404 there, never the page. docs/DEPLOY.md has the
	# three-line snippet and how to hash the password.
	#
	# `route`, not `handle`: handle re-sorts its directives into Caddy's
	# standard order, and in that order respond comes BEFORE file_server, so
	# the 404 fallback won every time (the 22 Aug 2026 deploy). route keeps
	# the written order — snippet first, the 404 only if nothing served.
	route /private/* {
		import /etc/caddy/private/*.caddy
		respond 404
	}
	# web-data/private sits inside the /data mount as well, so the same file
	# has a second address. That one is never served, snippet or not.
	handle /data/private/* {
		respond 404
	}

	# The app page (web/app.html, app-en.html) asks one question — do you
	# want PapaMap as an app? — and counts the answer: each of its two
	# buttons POSTs to one of the paths below, answered 204 with no body.
	# Nothing else on this host answers POST. The Origin condition is what
	# a browser sends with every POST from the page itself; a fetch from
	# someone else's page carries theirs and falls through to a 404. curl
	# can fake it, which is what the Cloudflare rate limit is for.
	@tap {
		method POST
		path /app/ja/iphone /app/ja/android
		header Origin https://papamap.de
	}
	# A handle block, not a bare respond: the site-wide Cache-Control below
	# is set before it and this one wins, so no edge ever keeps the answer
	# to a tap. A counted tap is not a document.
	handle @tap {
		header Cache-Control "no-store"
		respond 204
	}

	# That count is this container's only access log, and it holds the taps
	# and nothing else: log_skip drops every request outside /app/ja/ before
	# it is written — page views included, because methods.html promises
	# no analytics and a tap is an answer, not a visit — and the filter
	# deletes the client address, every request header (User-Agent,
	# Referer, cookies), the host, the protocol, the sizes and the duration
	# from the lines that remain, and cuts any query string off the path.
	# A line is a timestamp, a method, a path and a status, which is what
	# datenschutz.html says it is, and identifies nobody. Written to
	# ./caddy-logs on the host (a mount in docker-compose.yml, created by
	# the deploying user, docs/DEPLOY.md); pipeline.ops reads it into the
	# private ops page and the Monday mail. mode 0644 because Caddy runs as
	# root in the image and the ops cron does not. log_skip and mode need
	# Caddy 2.8+ (2024) — validate the file against the image before
	# restarting, DEPLOY.md shows how.
	@outside_taps not path /app/ja/*
	log_skip @outside_taps
	log {
		output file /var/log/caddy/app.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 400d
			mode 0644
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
				request>host delete
				request>proto delete
				request>uri regexp "[?].*$" ""
				resp_headers delete
				bytes_read delete
				size delete
				duration delete
				user_id delete
			}
		}
	}

	# The data files are regenerated daily; the rest is versioned by URL — bar
	# the Bundesland pages under /wickeltische/, which are also regenerated
	# nightly but keep plain URLs (they are indexed). An hour of staleness on a
	# page that changes once a night is not worth a shorter TTL.
	@data path /data/* /ops.html
	header @data Cache-Control "public, max-age=900"
	header Cache-Control "public, max-age=3600"
}
